PORT=3000
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0
META_MIN_WRITE_INTERVAL_MS=5000

# Produção persistente. Deixe as duas vazias para usar data/db.json localmente.
SUPABASE_URL=
# Use uma Secret key nova (sb_secret_...) ou, em projetos antigos, a service_role.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_ID=default
DATA_PATH=./data/db.json

# Agente de qualificação. A chave existe somente no servidor.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=
AGENTROUTER_MODEL=
AGENTROUTER_TIMEOUT_MS=20000
