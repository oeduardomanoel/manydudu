{
  "name": "manydudu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node src/server.js",
    "gateway": "node --env-file=.env src/webhook-gateway.js",
    "dev:landing": "vite --config landing/vite.config.ts --host 0.0.0.0 --port 5173",
    "build:landing": "vite build --config landing/vite.config.ts",
    "preview:landing": "vite preview --config landing/vite.config.ts --host 0.0.0.0 --port 4173",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "engines": { "node": ">=22" }
}
